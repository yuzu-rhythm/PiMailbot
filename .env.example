# This file intentionally contains no token, password, cookie, or OAuth value.
# Copy it to a private local file only after deciding the exact scopes.
MAILBOT_DATABASE_PATH=data/mailbot.sqlite3
MAILBOT_IMAGE_DIR=data/images
MAILBOT_MAX_IMAGE_BYTES=8388608

# Empty values keep Discord disabled or deny every command (default deny).
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_GUILDS=
DISCORD_ALLOWED_CHANNELS=
DISCORD_ALLOWED_USERS=

# Gmail is read-only and disabled until OAuth is complete and deployment approved.
MAILBOT_GMAIL_ENABLED=false
MAILBOT_GMAIL_TOKEN_PATH=
MAILBOT_GMAIL_DATABASE_PATH=
MAILBOT_GMAIL_POLL_SECONDS=90

# Enable only after explicit gmail.modify consent and deployment approval.
MAILBOT_GMAIL_ACTIONS_ENABLED=false
MAILBOT_GMAIL_TASKS_ENABLED=false

# Gemini preview summaries: both enablement and explicit data-transfer consent required.
MAILBOT_GEMINI_ENABLED=false
MAILBOT_GEMINI_PREVIEW_CONSENT=false
MAILBOT_GEMINI_KEY_PATH=data/gemini/api-key.txt
MAILBOT_GEMINI_MODEL=gemini-3.5-flash-lite
MAILBOT_GEMINI_DAILY_LIMIT=20

# Todoist: opt-in. No existing tasks are automatically exported.
MAILBOT_TODOIST_ENABLED=false
MAILBOT_TODOIST_TOKEN_PATH=data/todoist/token.txt
MAILBOT_TODOIST_POLL_SECONDS=90
# Empty means Todoist Inbox.
MAILBOT_TODOIST_PROJECT_ID=

# Optional private mailbox routing manifest. Existing single mailbox is used if empty.
MAILBOT_GMAIL_ACCOUNTS_PATH=
# Explicit opt-in for recoverable Trash and archive after confirmed Todoist creation.
MAILBOT_GMAIL_TRASH_ENABLED=false
MAILBOT_GMAIL_TASK_ARCHIVE_ENABLED=false
